<!doctype html>
<html><body style="font-family: Segoe UI, sans-serif; color:#222; max-width:680px;">
<h2 style="color:#1f3a5f;">Windows Patch Posture — Grade {{ fleet_posture.grade }} ({{ fleet_posture.score }}/100)</h2>
<p>Run completed {{ report_stamp }} UTC. {{ fleet_posture.host_count }} hosts analysed
({{ fleet_posture.compliant }} compliant, {{ fleet_posture.at_risk }} at risk).</p>

<h3>Top {{ top_risks | length }} risks</h3>
{% if top_risks %}
<ol>
{% for r in top_risks %}
<li><b>{{ r.hostname }}</b> [{{ r.grade }}] — {{ r.reason }}</li>
{% endfor %}
</ol>
{% else %}<p>None — fleet is in good shape.</p>{% endif %}

<p>Full HTML report and CSV are attached as job artifacts in AAP.</p>
<p style="font-size:11px; color:#888;">Generated by AAP Windows Patching workflow.</p>
</body></html>
